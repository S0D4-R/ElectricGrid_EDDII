<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Targets the .NET version of whichever SDK builds it (8, 9, 10...), so no extra packages or
         runtimes are needed and nothing depends on the user's NuGet configuration. Requires .NET 8 SDK or newer. -->
    <TargetFramework>net$(BundledNETCoreAppTargetFrameworkVersion)</TargetFramework>
    <!-- If the app is ever built with an older SDK but run on a newer runtime, accept it. -->
    <RollForward>Major</RollForward>

    <RootNamespace>ElectricGrid.ConsoleApp</RootNamespace>
    <AssemblyName>ElectricGrid</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ElectricGrid.Core\ElectricGrid.Core.csproj" />
  </ItemGroup>

  <!-- Sample CSV files are copied next to the executable so they can be loaded out of the box. -->
  <ItemGroup>
    <None Update="Data\*.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Targets the .NET version of whichever SDK builds it (8, 9, 10...), so no extra packages or
         runtimes are needed and nothing depends on the user's NuGet configuration. Requires .NET 8 SDK or newer. -->
    <TargetFramework>net$(BundledNETCoreAppTargetFrameworkVersion)</TargetFramework>

    <RootNamespace>ElectricGrid.Core</RootNamespace>
    <AssemblyName>ElectricGrid.Core</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
